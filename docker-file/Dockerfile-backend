# 使用官方 Maven 镜像，避免构建阶段 apt 源不可用（如 503）
FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /app

# 仅创建 Maven 阿里云镜像配置（无需 apt，避免 Ubuntu 源故障）
RUN echo '<settings>\
 <mirrors>\
   <mirror>\
     <id>aliyun</id>\
     <url>https://maven.aliyun.com/repository/public</url>\
     <mirrorOf>*</mirrorOf>\
   </mirror>\
 </mirrors>\
 <profiles>\
   <profile>\
     <id>default</id>\
     <activation>\
       <activeByDefault>true</activeByDefault>\
     </activation>\
     <properties>\
       <maven.compiler.source>17</maven.compiler.source>\
       <maven.compiler.target>17</maven.compiler.target>\
     </properties>\
   </profile>\
 </profiles>\
</settings>' > /app/aliyun-settings.xml

# 先只复制 POM，利用层缓存：依赖未变时跳过下载
COPY pom.xml DataAgent/
COPY data-agent-management/pom.xml DataAgent/data-agent-management/
WORKDIR /app/DataAgent
# 仅下载依赖（POM 未变时此层被缓存，大幅加速重复构建）
RUN --mount=type=cache,target=/root/.m2 \
    mvn dependency:resolve dependency:resolve-plugins -B -s /app/aliyun-settings.xml

# 再复制源码并编译（代码变更时只重跑这一层及之后）
# 跳过 checkstyle/spotless：镜像内无 .git，spotless 的 ratchetFrom 会报错
COPY . /app/DataAgent
RUN --mount=type=cache,target=/root/.m2 \
    mvn install -DskipTests -B -s /app/aliyun-settings.xml \
    -Dcheckstyle.skip=true -Dspotless.skip=true

FROM eclipse-temurin:17-jdk-jammy

WORKDIR /app

COPY --from=build /app/DataAgent/data-agent-management/target/spring-ai-alibaba-data-agent-management-1.0.0-SNAPSHOT.jar /app/app.jar

# 使用阿里云 apt 源（仅 jammy main），x86 用 ubuntu，arm64 用 ubuntu-ports
# python3 最小安装无 ensurepip，用 get-pip.py 自举 pip（避免依赖 universe 的 python3-pip/python3-venv）
# pip 使用阿里云 PyPI 镜像；pandas/numpy 供 PythonGenerateNode 生成的脚本使用
RUN rm -f /etc/apt/sources.list.d/ubuntu.sources; \
    if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
      echo 'deb https://mirrors.aliyun.com/ubuntu-ports jammy main' > /etc/apt/sources.list; \
    else \
      echo 'deb https://mirrors.aliyun.com/ubuntu jammy main' > /etc/apt/sources.list; \
    fi; \
    for i in 1 2 3; do apt-get update && break || sleep 15; done; \
    for i in 1 2 3; do apt-get install -y --no-install-recommends python3 curl && break || sleep 20; done \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3 - -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com \
    && for i in 1 2 3; do pip3 install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com pandas numpy && break || sleep 20; done \
    && rm -rf /var/lib/apt/lists/* /root/.cache/pip \
    && mkdir -p /app/config

EXPOSE 8065

ENTRYPOINT ["java", "-jar", "app.jar", "--spring.config.location=classpath:application.yml,optional:file:/app/config/application.yml"]
