FROM node:20-alpine AS builder

WORKDIR /app

# 先只复制依赖清单，利用层缓存：依赖未变时跳过 npm install
COPY data-agent-frontend/package.json data-agent-frontend/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm config set registry https://registry.npmmirror.com && npm ci

# 再复制源码并构建（代码变更时只重跑这一层及之后）
COPY data-agent-frontend .
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
